{
  "name": "dbchat-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "dbchat 前端 —— 自然语言数据库查询助手（Vue 3 + Vite + TypeScript，无 CDN 依赖）",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "check:types": "node scripts/check-types.mjs",
    "smoke": "node scripts/render-smoke.mjs",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "dompurify": "^3.4.15",
    "marked": "^18.0.13",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vue-tsc": "^3.3.11"
  }
}
