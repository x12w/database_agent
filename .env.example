# 复制为 .env 后填写。.env 已被 gitignore，不会进版本库。

# ---- LLM ----
# provider 留空则按 key 前缀自动判定：sk-ant- 开头视为 anthropic，否则 openai 兼容
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_API_BASE=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.1

# Anthropic 原生（LLM_PROVIDER=anthropic 时使用）
# ANTHROPIC_API_KEY=

# ---- 默认数据库（也可在界面里配置多个连接）----
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=training_exam_db
# mysql / postgresql / dameng
DB_TYPE=mysql

# ---- 超时（秒）----
LLM_TIMEOUT_S=120
DB_CONNECT_TIMEOUT_S=30
DB_QUERY_TIMEOUT_S=60
SANDBOX_TIMEOUT_S=15
# 单次提问的总预算，超出后主动收尾返回已有结果
RUN_TIMEOUT_S=300

# ---- 迭代上限 ----
MAX_QUERY_ROUNDS=5
MAX_ANALYSIS_ITERATIONS=6
MAX_SQL_ITERATIONS=3

# ---- 展示策略 ----
# 是否把原始 SQL 作为可展开项发给前端（默认关闭）
EXPOSE_SQL_TO_USER=false
# 是否流式展示模型思考过程（默认开启，长耗时任务需要让用户看到进展）
EXPOSE_THINKING=true

# ---- 服务 ----
HOST=0.0.0.0
PORT=8000
DEBUG=false
